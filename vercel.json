{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "reader",
  "rewrites": [
    { "source": "/s/:slug", "destination": "/api/page?slug=:slug" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "reader/index.html" }
  }
}
